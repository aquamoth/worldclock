{
  "name": "worldclock",
  "version": "1.0.0",
  "private": true,
  "author": "Trustfall AB (https://www.trustfall.se)",
  "homepage": "https://aquamoth.github.io/worldclock/",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "build:android": "pnpm run prebuild && cd android && ./gradlew assembleDebug",
    "build:android:release": "pnpm run prebuild && cd android && NODE_ENV=production ./gradlew assembleRelease",
    "release:cng-check": "bash scripts/release/verify-cng-reproducibility.sh",
    "release:clean-gate": "bash scripts/release/run-clean-android-gate.sh",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "catalog:generate": "tsx scripts/generate-clock-catalog.ts",
    "catalog:check": "tsx scripts/generate-clock-catalog.ts --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.14",
    "expo-build-properties": "57.0.12",
    "expo-haptics": "~57.0.1",
    "expo-localization": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "graphemer": "1.4.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "unicode-case-folding": "1.1.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.4",
    "expo-doctor": "1.20.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "react-test-renderer": "19.2.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "xcode>uuid": "^11.1.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|unicode-case-folding))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ]
  }
}
