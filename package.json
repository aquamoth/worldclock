{
  "name": "worldclock",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "build:android": "npm run prebuild && cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "expo": "57.0.14",
    "expo-build-properties": "57.0.12",
    "expo-localization": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ]
  }
}
